{
  "name": "karlbergsbro-static",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ./",
    "format": "prettier --write --ignore-path .gitignore ./",
    "test": "jest",
    "e2e": "CYPRESS_DIST=.e2e yarn build && start-server-and-test 'CYPRESS_DIST=.e2e NODE_ENV=test yarn start -p 4444' :4444 'CYPRESS_BASE_URL=http://localhost:4444 yarn cy:run --config video=false'",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "prepare": "husky install",
    "smoketest": "yarn lint && yarn build && yarn test && yarn e2e"
  },
  "dependencies": {
    "@vercel/speed-insights": "2.1.0",
    "bootstrap": "5.3.8",
    "fast-memoize": "2.5.2",
    "gray-matter": "4.0.3",
    "next": "16.4.5",
    "nodemailer": "10.4.0",
    "normalize-unicode-text": "0.0.1",
    "react": "19.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "cypress": "16.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-cypress": "7.0.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "git-cz": "4.9.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "pretty-quick": "4.2.2",
    "start-server-and-test": "3.0.13"
  },
  "engines": {
    "node": ">=26"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "packageManager": "yarn@4.4.1"
}
