{
  "name": "karlbergsbro-static",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky install",
    "smoketest": "yarn lint && yarn build && yarn test && yarn e2e"
  },
  "dependencies": {
    "@vercel/speed-insights": "2.1.0",
    "bootstrap": "5.3.8",
    "fast-memoize": "2.5.2",
    "gray-matter": "4.0.3",
    "next": "16.4.5",
    "nodemailer": "10.4.0",
    "react": "19.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "git-cz": "4.9.0",
    "husky": "9.1.7",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "packageManager": "yarn@4.4.1"
}
